root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# Patches are byte-exact: trailing whitespace is significant in diff
# context lines, so never let an editor normalise these.
[*.{patch,diff}]
trim_trailing_whitespace = false
insert_final_newline = false

[*.rs]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.{css,scss}]
indent_style = space
indent_size = 2

[*.bst]
indent_style = space
indent_size = 2

[meson.build]
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 2

[*.bats]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 4

[*.xml]
indent_style = space
indent_size = 2

[{Containerfile,Dockerfile}*]
indent_style = space
indent_size = 4

[{justfile,Justfile}]
indent_style = space
indent_size = 2

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
