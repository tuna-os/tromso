# Options of the default Tromso kernel that bazzite.config does not enable and
# that hardware or a feature of the image uses. Compared with the kernel of
# ghcr.io/tuna-os/tromso:latest of 2026-10-15 (6.19.11). The other differences
# are debug options, legacy network vendors, board regulators, and options
# that Kconfig derives.
CONFIG_WLAN_VENDOR_INTERSIL=y
CONFIG_P54_COMMON=m
CONFIG_P54_USB=m
CONFIG_P54_PCI=m
CONFIG_LIBERTAS=m
CONFIG_LIBERTAS_USB=m
CONFIG_LIBERTAS_SDIO=m
CONFIG_RTL8192CU=m
CONFIG_VIRTIO_PMEM=m
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
