# Tromso policy on top of the OGC configuration. Every line is asserted by
# merge-config.sh after `make olddefconfig`.

# The release string must not look like a Fedora package.
CONFIG_LOCALVERSION="-ogc3-tromso"
# CONFIG_LOCALVERSION_AUTO is not set

# Module signatures. The key is made for each build and lives only in the
# tmpfs of the sandbox (see elements/ogc/linux.bst). RSA, because the OpenSSL
# of the SDK decides which other types work.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_HASH="sha512"
CONFIG_MODULE_SIG_KEY="/tmp/ogc-modsign/signing_key.pem"
CONFIG_MODULE_SIG_KEY_TYPE_RSA=y
# CONFIG_MODULE_SIG_KEY_TYPE_MLDSA_87 is not set
CONFIG_SYSTEM_TRUSTED_KEYS=""

# Lockdown stays available, and is in the LSM list.
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LSM="lockdown,yama,integrity,selinux,bpf,landlock,ipe"

# zstd: the initramfs generator of Tromso reads .ko.zst.
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
# CONFIG_MODULE_COMPRESS_XZ is not set
CONFIG_MODULE_COMPRESS_ALL=y
CONFIG_MODULE_DECOMPRESS=y

# BTF for sched_ext, with compressed DWARF in the build tree.
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_DEBUG_INFO_COMPRESSED_ZSTD=y
# CONFIG_DEBUG_INFO_COMPRESSED_NONE is not set

# The boot path of the image: composefs on EROFS with fs-verity, overlayfs,
# ext4 and btrfs roots, LUKS. The initramfs has the fs/ modules, but not
# drivers/block. bootc-root-setup (bootc 1.15, feature pre-6.15) mounts the
# composefs image through a loop device, so loop is built in, as in the
# freedesktop-sdk kernel. Without it: "Creating filesystem mount: No such file
# or directory" (runs 45840016109, 45870349359).
CONFIG_BLK_DEV_LOOP=y
CONFIG_EROFS_FS=m
CONFIG_OVERLAY_FS=m
CONFIG_FS_VERITY=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=m
CONFIG_DM_CRYPT=m
CONFIG_DM_VERITY=m
CONFIG_SQUASHFS=m
CONFIG_ISO9660_FS=m
