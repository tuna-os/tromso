# EXPERIMENT ONLY — not wired to CI, Justfile, or elements/.
# Try tine (Buck2-based DDI builder) next to the BuildStream pipeline.
# Run everything through tine/bin/tine from the repo root, e.g.:
#   tine/bin/tine init                    # one-time: registers the tine cell
#   tine/bin/tine buck build //tine-poc:boot-demo.fedora
#   tine/bin/tine buck run //tine-poc:boot-demo-vm.fedora
"""Minimal Fedora bootable-disk PoC plus a KDE desktop sketch (package list TBD)."""

load("@tine//distribution:defs.bzl", "distribution")
load("@tine//image:defs.bzl", "image")
load("@tine//package:defs.bzl", "package")

# Consumer-owned solve context rooted at tine's Fedora Rawhide catalog.
# A real product would track its own catalog instead of following tine's.
package.manager(
    name = "image.package-manager",
    base = "tine//catalog:fedora.rawhide.package-manager",
)

# Smallest thing that proves the DDI path: bootable verity GPT disk.
image.bootable_disk(
    name = "boot-demo",
    package_manager = ":image.package-manager",
    definitions = image.DEFAULT_USR_VERITY_PARTITIONS,
    version = "unversioned",
    package_sets = ["bootable"],
    packages = ["bash"],
    install_docs = False,
    output_size = "2G",
)

image.vm(
    name = "boot-demo-vm",
    autologin = "root",
    credentials = {
        "firstboot.timezone": "UTC",
    },
    box = "tine//catalog:fedora.rawhide.box",
    image = ":boot-demo",
)

# KDE Plasma rootfs (tar) for comparison with elements/oci/tromso.bst and
# as input to oci-export.sh (bootc-compatible OCI). Package names verified
# against tine//catalog snapshot fedora.rawhide.x86_64.json on 2026-10-07.
image.rootfs_archive(
    name = "kde-rootfs",
    package_manager = ":image.package-manager",
    packages = [
        "bash",
        "coreutils",
        "systemd",
        "glibc",
        "dbus",
        "polkit",
        "fedora-release-common",
        "kernel",
        "kernel-modules",
        "dracut",
        "dracut-config-generic",
        "ostree",
        "composefs",
        "bootc",
        "bootupd",
        # bootc install shells out to mkfs/tune2fs from the target image
        # itself (verified: "Creating root filesystem (btrfs)" then bare
        # ENOENT — mkfs.btrfs absent). util-linux comes via deps already.
        "btrfs-progs",
        "xfsprogs",
        "dosfstools",
        "e2fsprogs",
        "systemd-boot-unsigned",
        "shim-x64",
        "grub2-efi-x64",
        "selinux-policy-targeted",
        "linux-firmware",
        "NetworkManager",
        "openssh-server",
        "systemd-pam",
        "accountsservice",
        "upower",
        "udisks2",
        "pipewire",
        "wireplumber",
        "mesa-dri-drivers",
        "xorg-x11-server-Xwayland",
        "sddm",
        "sddm-wayland-plasma",
        "sddm-breeze",
        "plasma-desktop",
        "plasma-workspace",
        "kwin",
        "dolphin",
        "konsole",
        "kate",
        "kinfocenter",
        "plasma-nm",
        "plasma-pa",
        "powerdevil",
        "kscreen",
        "bluedevil",
        "plasma-firewall",
        "kde-gtk-config",
        "breeze-gtk",
        "plasma-lookandfeel-fedora",
        "kde-settings",
        "xdg-desktop-portal-kde",
    ],
    ops = [
        # Display-manager wiring mirrors elements/tromso/system-config.bst.
        image.run(["/usr/bin/systemctl", "enable", "sddm.service"], chroot = True),
        image.run(["/usr/bin/systemctl", "set-default", "graphical.target"], chroot = True),
        # Kernel %post does not yield an initramfs in tine's box (verified
        # missing in race-38fa511d), and bootc requires initramfs.img next
        # to vmlinuz. Generate it explicitly; no $() — Buck claims that.
        image.run(["/usr/bin/bash", "-c", "for k in /usr/lib/modules/*; do [ -f \"$k/vmlinuz\" ] || continue; /usr/bin/dracut --force --no-hostonly --add \"ostree bootc\" \"$k/initramfs.img\" \"${k##*/}\"; done"], chroot = True),
        # No RPM ships /usr/lib/ostree/prepare-root.conf (verified via the
        # snapshot filelists: only a doc sample inside bootc). Author the
        # canonical composefs content (bootc-dev/bootc baseimage) directly.
        image.write_file("/usr/lib/ostree/prepare-root.conf", "[composefs]\nenabled = true\n"),
        # bootc container lint baseimage-root fails without /sysroot, and
        # rejects payload in /boot (shim/grub2 drop efi/grub2 dirs there;
        # the bootloader is installed at install time, so remove them).
        image.run(["/usr/bin/mkdir", "-p", "/sysroot"], chroot = True),
        image.run(["/usr/bin/bash", "-c", "rm -rf /boot/efi /boot/grub2 /boot/loader; mkdir -p /boot"], chroot = True),
        # Diagnosability: serial console kargs (KubeVirt console is silent
        # otherwise), sshd for corral's --root-ssh-authorized-keys login.
        image.write_file("/usr/lib/bootc/kargs.d/10-console.toml", "kargs = [\"console=ttyS0,115200\"]\n"),
        image.run(["/usr/bin/systemctl", "enable", "sshd.service"], chroot = True),
        # Nothing enables the network by default in this rootfs (no route
        # to the booted VM); enable NetworkManager explicitly.
        image.run(["/usr/bin/systemctl", "enable", "NetworkManager.service"], chroot = True),
        # Pre-seed firstboot answers or the boot stalls at an interactive
        # "Initial Setup" timezone prompt (verified on serial). zoneinfo
        # ships in the image; factory locale.conf does not get applied.
        image.write_file("/etc/locale.conf", "LANG=C.UTF-8\n"),
        image.write_file("/etc/hostname", "tine-kde\n"),
        image.run(["/usr/bin/ln", "-sf", "../usr/share/zoneinfo/UTC", "/etc/localtime"], chroot = True),
        # bootc injects the install-time SSH key via tmpfiles, but it lands
        # mislabeled (var_t) and sshd (enforcing) refuses it. tmpfiles
        # z-rules fail here (/var still read-only at tmpfiles time), and an
        # /etc wants-symlink vanishes from the deployed tree — so ship a
        # oneshot with STATIC enablement in /usr/lib, ordered after
        # var.mount and before sshd.
        image.write_file("/usr/lib/systemd/system/tine-poc-ssh-labels.service", "[Unit]\nDescription=Tine PoC: label root SSH keys after /var mount\nAfter=var.mount systemd-tmpfiles-setup.service\nBefore=sshd.service sshd.socket\n\n[Service]\nType=oneshot\nExecStart=/usr/bin/chcon -u system_u -t ssh_home_t /root/.ssh /root/.ssh/authorized_keys\nRemainAfterExit=yes\n\n[Install]\nWantedBy=multi-user.target\n"),
        image.run(["/usr/bin/bash", "-c", "mkdir -p /usr/lib/systemd/system/multi-user.target.wants && ln -sf ../tine-poc-ssh-labels.service /usr/lib/systemd/system/multi-user.target.wants/tine-poc-ssh-labels.service"], chroot = True),
        # sshd reads ~root/.ssh, but the install-time key lands in
        # /var/roothome/.ssh. Working images (utah) ship /root as a
        # symlink to var/roothome; ours was a real dir, so sshd never saw
        # the key (and the relabel unit hit the wrong path too).
        image.run(["/usr/bin/bash", "-c", "rm -rf /root && ln -s var/roothome /root"], chroot = True),
        # With locale/hostname/timezone pre-seeded, firstboot only ever
        # prompts for a root password and stalls headless boots. The image
        # is key-only by design (see unit above), so mask it; machine-id is
        # still generated on boot by systemd-machine-id-setup.
        image.run(["/usr/bin/systemctl", "mask", "systemd-firstboot.service"], chroot = True),
    ],
    install_docs = False,
    format = "tar",
)
