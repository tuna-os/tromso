Fix shiboken internal error: Class "QByteArray" for
"QShaderCode::QShaderCode()" not found.

The typesystem_gui_rhi.xml is loaded as a sub-typesystem of
typesystem_gui.xml but is processed in a context where the QtCore
types (including QByteArray) are not yet available. Add explicit
load-typesystem directive to ensure QtCore types are resolved before
processing QShaderCode and other RHI-related value types that
reference Core types.

--- a/sources/pyside6/PySide6/QtGui/typesystem_gui_rhi.xml
+++ b/sources/pyside6/PySide6/QtGui/typesystem_gui_rhi.xml
@@ -4,6 +4,7 @@
 // SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
 -->
 <typesystem package="PySide6.QtGui">
+  <load-typesystem name="QtCore/typesystem_core.xml" generate="no"/>
   <object-type name="QRhiAdapter" since="6.10" private="yes"/>
   <value-type name="QRhiDepthStencilClearValue" since="6.6" private="yes"/>
   <value-type name="QRhiViewport" since="6.6" private="yes"/>
