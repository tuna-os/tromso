+++ b/patches/ogc-xwayland/0001-Revert-xwayland-Restrict-allow-commit-to-the-window-.patch
@@ -0,0 +1,77 @@
+From 805fa53079703599a8540abab0c96fa4359e4f12 Mon Sep 17 00:00:00 2001
+From: =?UTF-8?q?Vivek=20Das=C2=A0Mohapatra?= <vivek@collabora.com>
+Date: Wed, 16 Apr 2025 15:14:34 +0100
+Subject: [PATCH] Revert "xwayland: Restrict allow commit to the window
+ manager"
+
+Steamwebhelper seems to need access to this (previously unrestricted)
+functionality, otherwise we get a short black screen interval instead
+of a seamless boot display.
+
+This reverts commit 2cc869626a5728d8bd80241322546f98df96094d.
+---
+ hw/xwayland/xwayland-screen.c | 26 --------------------------
+ 1 file changed, 26 deletions(-)
+
+diff --git a/hw/xwayland/xwayland-screen.c b/hw/xwayland/xwayland-screen.c
+index c83adda..755cbad 100644
+--- a/hw/xwayland/xwayland-screen.c
++++ b/hw/xwayland/xwayland-screen.c
+@@ -181,34 +181,12 @@ xwl_property_callback(CallbackListPtr *pcbl, void *closure,
+         xwl_window_update_property(xwl_window, rec);
+ }
+ 
+-#ifdef XACE
+-#define readOnlyPropertyAccessMask (DixReadAccess |\
+-                                    DixGetAttrAccess |\
+-                                    DixListPropAccess |\
+-                                    DixGetPropAccess)
+-
+ static void
+ xwl_access_property_callback(CallbackListPtr *pcbl, void *closure,
+                              void *calldata)
+ {
+-    XacePropertyAccessRec *rec = calldata;
+-    PropertyPtr prop = *rec->ppProp;
+-    ClientPtr client = rec->client;
+-    Mask access_mode = rec->access_mode;
+-    ScreenPtr pScreen = closure;
+-    struct xwl_screen *xwl_screen = xwl_screen_get(pScreen);
+-
+-    if (prop->propertyName == xwl_screen->allow_commits_prop) {
+-        /* Only the WM and the Xserver itself */
+-        if (client != serverClient &&
+-            client->index != xwl_screen->wm_client_id &&
+-            (access_mode & ~readOnlyPropertyAccessMask) != 0)
+-            rec->status = BadAccess;
+-    }
+ }
+ 
+-#undef readOnlyPropertyAccessMask
+-#endif /* XACE */
+ 
+ static void
+ xwl_root_window_finalized_callback(CallbackListPtr *pcbl,
+@@ -239,9 +217,7 @@ xwl_close_screen(ScreenPtr screen)
+     xwl_dmabuf_feedback_destroy(&xwl_screen->default_feedback);
+ #endif
+     DeleteCallback(&PropertyStateCallback, xwl_property_callback, screen);
+-#ifdef XACE
+     XaceDeleteCallback(XACE_PROPERTY_ACCESS, xwl_access_property_callback, screen);
+-#endif
+ 
+     xorg_list_for_each_entry_safe(xwl_output, next_xwl_output,
+                                   &xwl_screen->output_list, link)
+@@ -1172,9 +1148,7 @@ xwl_screen_init(ScreenPtr pScreen, int argc, char **argv)
+ 
+     AddCallback(&PropertyStateCallback, xwl_property_callback, pScreen);
+     AddCallback(&RootWindowFinalizeCallback, xwl_root_window_finalized_callback, pScreen);
+-#ifdef XACE
+     XaceRegisterCallback(XACE_PROPERTY_ACCESS, xwl_access_property_callback, pScreen);
+-#endif
+ 
+     xwl_screen_setup_custom_vector(xwl_screen);
+ 
+-- 
+2.54.0
+
diff --git a/patches/ogc-xwayland/0002-Revert-xwayland-present-Check-allow_commits-in-xwl_p.patch b/patches/ogc-xwayland/0002-Revert-xwayland-present-Check-allow_commits-in-xwl_p.patch
new file mode 100644
index 0000000..2815384
--- /dev/null
+++ b/patches/ogc-xwayland/0002-Revert-xwayland-present-Check-allow_commits-in-xwl_p.patch
@@ -0,0 +1,32 @@
+From 7379c02245892b1f89e0c43f6cef2824f4a78bf8 Mon Sep 17 00:00:00 2001
+From: =?UTF-8?q?Vivek=20Das=C2=A0Mohapatra?= <vivek@collabora.com>
+Date: Tue, 22 Apr 2025 17:41:24 +0100
+Subject: [PATCH] Revert "xwayland/present: Check allow_commits in
+ xwl_present_flip"
+
+steamwebhelper currently sets _XWAYLAND_ALLOW_COMMITS to (uint32_t)0
+
+This is interpreted as FALSE when xwayland is checking whether commits
+are allowed: This was not checked prior to this commit and needs to be
+reverted to allow steamwebhelper to invoke xwl_present_flip.
+
+This reverts commit 7c25024879824cc96dc930e1af9e4c203eea740f.
+---
+ hw/xwayland/xwayland-present.c | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/hw/xwayland/xwayland-present.c b/hw/xwayland/xwayland-present.c
+index f349f71..88f7cd9 100644
+--- a/hw/xwayland/xwayland-present.c
++++ b/hw/xwayland/xwayland-present.c
+@@ -871,6 +871,6 @@ xwl_present_flip(present_vblank_ptr vblank, RegionPtr damage)
+     Bool                        implicit_sync = TRUE;
+ 
+-    if (!xwl_window || !xwl_window->allow_commits)
++    if (!xwl_window)
+         return FALSE;
+ 
+     buffer = xwl_pixmap_get_wl_buffer(pixmap);
+-- 
+2.47.1
+
diff --git a/patches/ogc-xwayland/0003-xwayland-pointer-warp-fix.patch b/patches/ogc-xwayland/0003-xwayland-pointer-warp-fix.patch
