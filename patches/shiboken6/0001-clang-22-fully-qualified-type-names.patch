+#if LLVM_VERSION >= 22
+    CXPrintingPolicy printingPolicy = clang_getCursorPrintingPolicy(rootCursor);
+    clang_PrintingPolicy_setProperty(printingPolicy, CXPrintingPolicy_IncludeNewlines, 0);
