Backport of upstream pyside-setup 2f25d2a3db, 27cb9caa49 and ddd6b00de2
(PYSIDE-3286, "Clang version 22 is now supported", picked to 6.11 only)
to 6.10.3. clang 22 clang_getTypeSpelling() no longer returns fully
qualified names, so shiboken resolved QDirListing::IteratorFlags to
QDirIterator::IteratorFlag. LLVM_VERSION comes from LLVM_PACKAGE_VERSION
in ApiExtractor/CMakeLists.txt (6.10 has no ShibokenGeneratorSetup.cmake).

diff --git a/sources/shiboken6/ApiExtractor/CMakeLists.txt b/sources/shiboken6/ApiExtractor/CMakeLists.txt
index c87bf5f..2ef34c2 100644
--- a/sources/shiboken6/ApiExtractor/CMakeLists.txt
+++ b/sources/shiboken6/ApiExtractor/CMakeLists.txt
@@ -126,9 +126,17 @@ if (NOT DISABLE_DOCSTRINGS)
                    qtdocparser.cpp qtdocparser.h)
 endif()
 
+# Backport of 2f25d2a3db: clang 22 changes behaviour without a CINDEX
+# version bump, so the parser needs the LLVM major version.
+string(REGEX REPLACE "\\..*$" "" LLVM_VERSION "${LLVM_PACKAGE_VERSION}")
+if(NOT LLVM_VERSION)
+    message(FATAL_ERROR "LLVM_PACKAGE_VERSION is not set; cannot define LLVM_VERSION")
+endif()
+
 target_compile_definitions(apiextractor
                            PRIVATE CMAKE_CXX_COMPILER="${CMAKE_CXX_COMPILER}"
-                           PRIVATE QT_LEAN_HEADERS=1)
+                           PRIVATE QT_LEAN_HEADERS=1
+                           PRIVATE LLVM_VERSION=${LLVM_VERSION})
 
 set(LIB_INSTALL_DIR "lib${LIB_SUFFIX}" CACHE PATH "The subdirectory relative to the install prefix where libraries will be installed (default is /lib${LIB_SUFFIX})" FORCE)
 
